# DistinctionOS XWM Player Configuration
# ========================================
# System default: /usr/share/DistinctionOS/xwm-player/config
# System override: /usr/local/share/DistinctionOS/xwm-player/config
# User override: ~/.config/DistinctionOS/xwm-player/config
#
# Override files need only contain the options you wish to change.
# Values are loaded in order: system → local → user

# =============================================================================
# AUDIO PLAYER SETTINGS
# =============================================================================

# Primary audio player to use
# For Flatpak apps, use the application ID (e.g., org.gnome.Decibels)
# For native apps, use the command name (e.g., totem)
PLAYER_COMMAND="org.gnome.Decibels"

# Player type: "flatpak", "native", or "auto"
# "auto" will detect based on PLAYER_COMMAND format (org.* = flatpak)
PLAYER_TYPE="native"

# Fallback player if primary is unavailable
FALLBACK_PLAYER="org.gnome.Totem"

# Fallback player type
FALLBACK_PLAYER_TYPE="auto"

# =============================================================================
# CONVERSION SETTINGS
# =============================================================================

# Output format for conversion: wav, ogg, mp3, flac
# wav is recommended: lossless, universally supported, and since temp files
# are in memory (XDG_RUNTIME_DIR), disk space isn't a concern
# Note: ogg requires libvorbis which may not be available on all systems
OUTPUT_FORMAT="wav"

# Audio quality settings
# For OGG: 0-10 (6 is good quality, ~160kbps)
# For MP3: bitrate in kbps (192 recommended)
# For FLAC: compression level 0-12 (5 is balanced)
# For WAV: ignored (lossless)
AUDIO_QUALITY="6"

# Preserve original sample rate (true/false)
# If false, resamples to 44100 Hz
PRESERVE_SAMPLE_RATE="true"

# Additional FFmpeg arguments (advanced users)
# Example: "-af loudnorm" for loudness normalisation
FFMPEG_EXTRA_ARGS=""

# =============================================================================
# SUPPORTED FORMATS
# =============================================================================
# Format handler mapping: extension → handler function
# Handlers are defined in /usr/share/DistinctionOS/xwm-player/handlers/
# To add new formats, create a handler and add it here
#
# Format: HANDLER_<EXT>="handler_function_name"

HANDLER_XWM="handle_xwm"
HANDLER_FUZ="handle_fuz"

# Future format support (uncomment when handlers are available)
# HANDLER_XMA="handle_xma"
# HANDLER_LIP="handle_lip"

# =============================================================================
# TEMPORARY FILE MANAGEMENT
# =============================================================================

# Temporary directory for converted files
# Default uses XDG_RUNTIME_DIR (tmpfs, cleared on logout)
# This ensures Flatpak sandboxed apps can access the files
TEMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/xwm-player"

# Cleanup mode: "on-exit", "immediate", "manual", "never"
# on-exit: Delete temp files when player closes (default)
# immediate: Delete as soon as playback starts (risky)
# manual: User must clean up via xwm-player --cleanup
# never: Temp files persist until logout/reboot
CLEANUP_MODE="on-exit"

# Cache conversions by file checksum (true/false)
# If true, repeated plays of the same file skip conversion
# Cache location: ~/.cache/DistinctionOS/xwm-player/
CACHE_CONVERSIONS="false"

# =============================================================================
# USER INTERFACE
# =============================================================================

# Show GUI error dialogues (true/false)
# Uses zenity, kdialog, or notify-send as fallback
GUI_ERRORS="true"

# Show notifications for manual conversions (true/false)
# Desktop file invocations are always silent
NOTIFY_MANUAL="true"

# Notification timeout in milliseconds
NOTIFY_TIMEOUT="3000"

# =============================================================================
# LOGGING
# =============================================================================

# Log level: "none", "error", "info", "debug"
LOG_LEVEL="error"

# Log file location
# Use "journal" to log to systemd journal instead
LOG_FILE="/var/log/distinctionos/xwm-player.log"

# =============================================================================
# ADVANCED OPTIONS
# =============================================================================

# FFmpeg binary path (usually auto-detected)
FFMPEG_BIN=""

# Timeout for conversion in seconds (0 = no timeout)
CONVERSION_TIMEOUT="300"

# Maximum file size to convert in MB (0 = no limit)
MAX_FILE_SIZE="0"
