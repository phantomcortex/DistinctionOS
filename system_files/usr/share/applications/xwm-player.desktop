[Desktop Entry]
Version=1.1
Type=Application
Name=XWM Player
GenericName=Game Audio Player
Comment=Play Bethesda game audio formats (XWM, FUZ)
Icon=audio-x-generic
Exec=xwm-player --desktop %f
Terminal=false
Categories=Audio;AudioVideo;Player;
MimeType=audio/x-xwm;audio/x-fuz;audio/x-xwma;
Keywords=xwm;fuz;bethesda;skyrim;fallout;audio;game;
StartupNotify=false
NoDisplay=false

# Desktop actions for additional functionality
Actions=convert-to-ogg;convert-to-mp3;

[Desktop Action convert-to-ogg]
Name=Convert to OGG
Exec=xwm-player --convert %f %f.ogg
Icon=audio-x-generic

[Desktop Action convert-to-mp3]
Name=Convert to MP3
Exec=xwm-player --convert %f %f.mp3
Icon=audio-x-generic
