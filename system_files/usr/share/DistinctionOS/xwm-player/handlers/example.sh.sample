#!/usr/bin/env bash
# =============================================================================
# DistinctionOS XWM Player - Example Handler
# =============================================================================
# This file demonstrates how to create custom format handlers.
#
# Handler files are sourced by xwm-player at startup. They should define
# functions that convert a specific format to a standard audio format.
#
# Installation locations (in order of precedence):
#   /usr/share/DistinctionOS/xwm-player/handlers/  (system)
#   /usr/local/share/DistinctionOS/xwm-player/handlers/  (local override)
#   ~/.config/DistinctionOS/xwm-player/handlers/  (user override)
#
# To enable a handler, add it to the config file:
#   HANDLER_EXT="function_name"
#
# Where EXT is the file extension (uppercase) and function_name is
# the function defined in this file.
# =============================================================================

# Example: Handler for a hypothetical .GAM format
#
# handle_gam() {
#     local input_file="$1"
#     local output_file="$2"
#     
#     log_info "Converting GAM: $input_file → $output_file"
#     
#     # Your conversion logic here
#     # The function should:
#     #   1. Read from $input_file
#     #   2. Convert to the format specified by $OUTPUT_FORMAT
#     #   3. Write to $output_file
#     #   4. Return 0 on success, non-zero on failure
#     
#     some_conversion_tool "$input_file" "$output_file"
# }

# =============================================================================
# NOTES FOR HANDLER AUTHORS
# =============================================================================
#
# Available variables (from config):
#   OUTPUT_FORMAT        - Target format (ogg, mp3, flac, wav)
#   AUDIO_QUALITY        - Quality setting for the format
#   PRESERVE_SAMPLE_RATE - Whether to keep original sample rate
#   FFMPEG_EXTRA_ARGS    - Additional FFmpeg arguments
#   TEMP_DIR             - Directory for temporary files
#   FFMPEG_BIN           - FFmpeg binary path (or empty for default)
#   CONVERSION_TIMEOUT   - Maximum conversion time in seconds
#
# Available functions:
#   log_info "message"   - Log informational message
#   log_debug "message"  - Log debug message
#   log_error "message"  - Log error message
#
# Temporary file management:
#   If your handler creates temporary files, add them to the
#   TEMP_FILES_CREATED array for automatic cleanup:
#     TEMP_FILES_CREATED+=("/path/to/temp/file")
#
# =============================================================================
