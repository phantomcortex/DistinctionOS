#!/usr/bin/env bash
# =============================================================================
# DistinctionOS XWM Player
# =============================================================================
# A wrapper to play Bethesda game audio formats (XWM, FUZ) in standard players
#
# Usage: xwm-player [OPTIONS] <file>
#        xwm-player --convert <input> <output>
#        xwm-player --cleanup
#
# Part of DistinctionOS - https://github.com/YOUR_REPO/DistinctionOS
# =============================================================================

set -euo pipefail

readonly VERSION="1.0.0"
readonly SCRIPT_NAME="$(basename "$0")"

# Configuration paths (in order of precedence, lowest to highest)
readonly SYSTEM_CONFIG="/usr/share/DistinctionOS/xwm-player/config"
readonly LOCAL_CONFIG="/usr/local/share/DistinctionOS/xwm-player/config"
readonly USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/DistinctionOS/xwm-player/config"

# Handler paths
readonly SYSTEM_HANDLERS="/usr/share/DistinctionOS/xwm-player/handlers"
readonly LOCAL_HANDLERS="/usr/local/share/DistinctionOS/xwm-player/handlers"
readonly USER_HANDLERS="${XDG_CONFIG_HOME:-$HOME/.config}/DistinctionOS/xwm-player/handlers"

# Runtime state
INVOKED_BY_DESKTOP="false"
TEMP_FILES_CREATED=()
PLAYER_PID=""

# =============================================================================
# DEFAULT CONFIGURATION (overridden by config files)
# =============================================================================

PLAYER_COMMAND="org.gnome.Decibels"
PLAYER_TYPE="auto"
FALLBACK_PLAYER="org.gnome.Totem"
FALLBACK_PLAYER_TYPE="auto"
OUTPUT_FORMAT="ogg"
AUDIO_QUALITY="6"
PRESERVE_SAMPLE_RATE="true"
FFMPEG_EXTRA_ARGS=""
HANDLER_XWM="handle_xwm"
HANDLER_FUZ="handle_fuz"
TEMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/xwm-player"
CLEANUP_MODE="on-exit"
CACHE_CONVERSIONS="false"
GUI_ERRORS="true"
NOTIFY_MANUAL="true"
NOTIFY_TIMEOUT="3000"
LOG_LEVEL="error"
LOG_FILE="/var/log/DistinctionOS/xwm-player.log"
FFMPEG_BIN=""
CONVERSION_TIMEOUT="300"
MAX_FILE_SIZE="0"

# =============================================================================
# LOGGING FUNCTIONS
# =============================================================================

log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    
    # Check if we should log this level
    case "$LOG_LEVEL" in
        none) return ;;
        error) [[ "$level" != "ERROR" ]] && return ;;
        info) [[ "$level" == "DEBUG" ]] && return ;;
        debug) ;; # Log everything
    esac
    
    local log_line="[$timestamp] [$level] $message"
    
    if [[ "$LOG_FILE" == "journal" ]]; then
        logger -t "xwm-player" -p "user.${level,,}" "$message"
    elif [[ -n "$LOG_FILE" ]] && [[ -w "$(dirname "$LOG_FILE")" || -w "$LOG_FILE" ]]; then
        echo "$log_line" >> "$LOG_FILE"
    fi
    
    # Also output to stderr for debug level
    [[ "$LOG_LEVEL" == "debug" ]] && echo "$log_line" >&2
}

log_error() { log "ERROR" "$@"; }
log_info() { log "INFO" "$@"; }
log_debug() { log "DEBUG" "$@"; }

# =============================================================================
# USER INTERFACE FUNCTIONS
# =============================================================================

show_error() {
    local title="$1"
    local message="$2"
    
    log_error "$title: $message"
    
    [[ "$GUI_ERRORS" != "true" ]] && return
    
    if command -v zenity &>/dev/null; then
        zenity --error --title="$title" --text="$message" --width=400 2>/dev/null &
    elif command -v kdialog &>/dev/null; then
        kdialog --error "$message" --title "$title" 2>/dev/null &
    elif command -v notify-send &>/dev/null; then
        notify-send -u critical "$title" "$message" 2>/dev/null &
    fi
}

show_notification() {
    local title="$1"
    local message="$2"
    
    # Only show for manual invocations
    [[ "$INVOKED_BY_DESKTOP" == "true" ]] && return
    [[ "$NOTIFY_MANUAL" != "true" ]] && return
    
    if command -v notify-send &>/dev/null; then
        notify-send -t "$NOTIFY_TIMEOUT" "$title" "$message" 2>/dev/null &
    fi
}

# =============================================================================
# CONFIGURATION LOADING
# =============================================================================

load_config() {
    local config_file="$1"
    
    [[ ! -f "$config_file" ]] && return 0
    
    log_debug "Loading configuration from: $config_file"
    
    # Source the config file safely
    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$key" ]] && continue
        
        # Remove leading/trailing whitespace
        key="$(echo "$key" | xargs)"
        value="$(echo "$value" | sed 's/^["'\'']*//;s/["'\'']*$//')"
        
        # Only set known variables
        case "$key" in
            PLAYER_COMMAND|PLAYER_TYPE|FALLBACK_PLAYER|FALLBACK_PLAYER_TYPE|\
            OUTPUT_FORMAT|AUDIO_QUALITY|PRESERVE_SAMPLE_RATE|FFMPEG_EXTRA_ARGS|\
            HANDLER_XWM|HANDLER_FUZ|HANDLER_XMA|HANDLER_LIP|\
            TEMP_DIR|CLEANUP_MODE|CACHE_CONVERSIONS|\
            GUI_ERRORS|NOTIFY_MANUAL|NOTIFY_TIMEOUT|\
            LOG_LEVEL|LOG_FILE|FFMPEG_BIN|CONVERSION_TIMEOUT|MAX_FILE_SIZE)
                declare -g "$key=$value"
                log_debug "Set $key=$value"
                ;;
        esac
    done < "$config_file"
}

load_all_configs() {
    load_config "$SYSTEM_CONFIG"
    load_config "$LOCAL_CONFIG"
    load_config "$USER_CONFIG"
    
    # Expand any variables in TEMP_DIR
    TEMP_DIR="$(eval echo "$TEMP_DIR")"
}

# =============================================================================
# FORMAT HANDLERS
# =============================================================================

# Load external handlers if they exist
load_handlers() {
    local handler_file
    for handler_dir in "$SYSTEM_HANDLERS" "$LOCAL_HANDLERS" "$USER_HANDLERS"; do
        if [[ -d "$handler_dir" ]]; then
            for handler_file in "$handler_dir"/*.sh; do
                [[ -f "$handler_file" ]] && source "$handler_file"
            done
        fi
    done
}

# Built-in XWM handler
handle_xwm() {
    local input_file="$1"
    local output_file="$2"
    
    log_info "Converting XWM: $input_file → $output_file"
    
    local ffmpeg_cmd=("${FFMPEG_BIN:-ffmpeg}")
    ffmpeg_cmd+=(-hide_banner -loglevel warning)
    ffmpeg_cmd+=(-y -i "$input_file")
    
    # Sample rate handling
    if [[ "$PRESERVE_SAMPLE_RATE" != "true" ]]; then
        ffmpeg_cmd+=(-ar 44100)
    fi
    
    # Format-specific encoding options
    case "$OUTPUT_FORMAT" in
        ogg)
            ffmpeg_cmd+=(-c:a libvorbis -q:a "$AUDIO_QUALITY")
            ;;
        mp3)
            ffmpeg_cmd+=(-c:a libmp3lame -b:a "${AUDIO_QUALITY}k")
            ;;
        flac)
            ffmpeg_cmd+=(-c:a flac -compression_level "$AUDIO_QUALITY")
            ;;
        wav)
            ffmpeg_cmd+=(-c:a pcm_s16le)
            ;;
        *)
            log_error "Unknown output format: $OUTPUT_FORMAT"
            return 1
            ;;
    esac
    
    # Add any extra arguments
    if [[ -n "$FFMPEG_EXTRA_ARGS" ]]; then
        # shellcheck disable=SC2206
        ffmpeg_cmd+=($FFMPEG_EXTRA_ARGS)
    fi
    
    ffmpeg_cmd+=("$output_file")
    
    log_debug "FFmpeg command: ${ffmpeg_cmd[*]}"
    
    if [[ "$CONVERSION_TIMEOUT" -gt 0 ]]; then
        timeout "$CONVERSION_TIMEOUT" "${ffmpeg_cmd[@]}"
    else
        "${ffmpeg_cmd[@]}"
    fi
}

# Built-in FUZ handler (Bethesda voice files)
# FUZ format: 4-byte magic "FUZE", 4-byte version, 4-byte lip size, then lip data, then xWMA data
handle_fuz() {
    local input_file="$1"
    local output_file="$2"
    
    log_info "Converting FUZ: $input_file → $output_file"
    
    # Read FUZ header to extract XWM data
    local magic lip_size
    magic="$(head -c 4 "$input_file")"
    
    if [[ "$magic" != "FUZE" ]]; then
        log_error "Invalid FUZ file: bad magic header"
        return 1
    fi
    
    # Read lip size (little-endian 32-bit at offset 8)
    lip_size=$(od -An -t u4 -j 8 -N 4 "$input_file" | tr -d ' ')
    
    # XWM data starts after: magic(4) + version(4) + lip_size(4) + lip_data(lip_size)
    local xwm_offset=$((12 + lip_size))
    
    log_debug "FUZ structure: lip_size=$lip_size, xwm_offset=$xwm_offset"
    
    # Extract XWM portion to temporary file
    local temp_xwm
    temp_xwm="$(mktemp "${TEMP_DIR}/fuz_extract_XXXXXX.xwm")"
    TEMP_FILES_CREATED+=("$temp_xwm")
    
    tail -c +$((xwm_offset + 1)) "$input_file" > "$temp_xwm"
    
    # Now convert the extracted XWM
    handle_xwm "$temp_xwm" "$output_file"
}

# =============================================================================
# PLAYER DETECTION AND LAUNCHING
# =============================================================================

detect_player_type() {
    local player="$1"
    local declared_type="$2"
    
    if [[ "$declared_type" != "auto" ]]; then
        echo "$declared_type"
        return
    fi
    
    # Auto-detect: if it looks like a Flatpak app ID, it's Flatpak
    if [[ "$player" =~ ^[a-zA-Z]+\.[a-zA-Z]+\.[a-zA-Z]+ ]]; then
        echo "flatpak"
    else
        echo "native"
    fi
}

check_player_available() {
    local player="$1"
    local player_type="$2"
    
    case "$player_type" in
        flatpak)
            flatpak info "$player" &>/dev/null
            ;;
        native)
            command -v "$player" &>/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

launch_player() {
    local file="$1"
    local player="$2"
    local player_type="$3"
    
    log_info "Launching $player ($player_type) with: $file"
    
    case "$player_type" in
        flatpak)
            flatpak run "$player" "$file" &
            PLAYER_PID=$!
            ;;
        native)
            "$player" "$file" &
            PLAYER_PID=$!
            ;;
    esac
    
    log_debug "Player PID: $PLAYER_PID"
}

# =============================================================================
# FILE OPERATIONS
# =============================================================================

get_file_extension() {
    local file="$1"
    echo "${file##*.}" | tr '[:upper:]' '[:lower:]'
}

get_handler_for_format() {
    local ext="$1"
    local handler_var="HANDLER_${ext^^}"
    
    echo "${!handler_var:-}"
}

get_cache_path() {
    local input_file="$1"
    local checksum
    
    checksum="$(sha256sum "$input_file" | cut -d' ' -f1)"
    echo "${XDG_CACHE_HOME:-$HOME/.cache}/DistinctionOS/xwm-player/${checksum}.${OUTPUT_FORMAT}"
}

ensure_temp_dir() {
    if [[ ! -d "$TEMP_DIR" ]]; then
        mkdir -p "$TEMP_DIR"
        log_debug "Created temp directory: $TEMP_DIR"
    fi
}

cleanup_temp_files() {
    log_debug "Cleaning up ${#TEMP_FILES_CREATED[@]} temporary files"
    
    for temp_file in "${TEMP_FILES_CREATED[@]}"; do
        if [[ -f "$temp_file" ]]; then
            rm -f "$temp_file"
            log_debug "Removed: $temp_file"
        fi
    done
    
    TEMP_FILES_CREATED=()
}

cleanup_all_temp() {
    if [[ -d "$TEMP_DIR" ]]; then
        rm -rf "${TEMP_DIR:?}"/*
        log_info "Cleaned up all files in: $TEMP_DIR"
    fi
}

# =============================================================================
# MAIN CONVERSION LOGIC
# =============================================================================

convert_and_play() {
    local input_file="$1"
    
    # Validate input file
    if [[ ! -f "$input_file" ]]; then
        show_error "File Not Found" "The file does not exist:\n$input_file"
        return 1
    fi
    
    # Check file size limit
    if [[ "$MAX_FILE_SIZE" -gt 0 ]]; then
        local file_size_mb
        file_size_mb=$(( $(stat -c%s "$input_file") / 1024 / 1024 ))
        if [[ "$file_size_mb" -gt "$MAX_FILE_SIZE" ]]; then
            show_error "File Too Large" "File exceeds maximum size of ${MAX_FILE_SIZE}MB"
            return 1
        fi
    fi
    
    # Determine format and handler
    local ext handler
    ext="$(get_file_extension "$input_file")"
    handler="$(get_handler_for_format "$ext")"
    
    if [[ -z "$handler" ]]; then
        show_error "Unsupported Format" "No handler found for .$ext files"
        return 1
    fi
    
    if ! type -t "$handler" &>/dev/null; then
        show_error "Handler Error" "Handler function '$handler' not found"
        return 1
    fi
    
    # Check FFmpeg availability
    local ffmpeg="${FFMPEG_BIN:-ffmpeg}"
    if ! command -v "$ffmpeg" &>/dev/null; then
        show_error "Missing Dependency" "FFmpeg is not installed or not in PATH"
        return 1
    fi
    
    # Determine output file path
    local output_file base_name
    base_name="$(basename "$input_file" ".$ext")"
    
    if [[ "$CACHE_CONVERSIONS" == "true" ]]; then
        output_file="$(get_cache_path "$input_file")"
        mkdir -p "$(dirname "$output_file")"
        
        # Skip conversion if cached
        if [[ -f "$output_file" ]]; then
            log_info "Using cached conversion: $output_file"
        else
            "$handler" "$input_file" "$output_file" || {
                show_error "Conversion Failed" "Failed to convert:\n$input_file"
                return 1
            }
        fi
    else
        ensure_temp_dir
        output_file="${TEMP_DIR}/${base_name}.${OUTPUT_FORMAT}"
        TEMP_FILES_CREATED+=("$output_file")
        
        "$handler" "$input_file" "$output_file" || {
            show_error "Conversion Failed" "Failed to convert:\n$input_file"
            return 1
        }
    fi
    
    show_notification "Conversion Complete" "Now playing: $base_name"
    
    # Find and launch player
    local player player_type
    player_type="$(detect_player_type "$PLAYER_COMMAND" "$PLAYER_TYPE")"
    
    if check_player_available "$PLAYER_COMMAND" "$player_type"; then
        player="$PLAYER_COMMAND"
    else
        log_info "Primary player unavailable, trying fallback"
        player_type="$(detect_player_type "$FALLBACK_PLAYER" "$FALLBACK_PLAYER_TYPE")"
        
        if check_player_available "$FALLBACK_PLAYER" "$player_type"; then
            player="$FALLBACK_PLAYER"
        else
            show_error "No Player Available" "Neither $PLAYER_COMMAND nor $FALLBACK_PLAYER could be found"
            return 1
        fi
    fi
    
    launch_player "$output_file" "$player" "$player_type"
    
    # Handle cleanup based on mode
    case "$CLEANUP_MODE" in
        on-exit)
            # Wait for player to exit, then cleanup
            if [[ -n "$PLAYER_PID" ]]; then
                wait "$PLAYER_PID" 2>/dev/null || true
            fi
            cleanup_temp_files
            ;;
        immediate)
            # Give player a moment to read the file, then cleanup
            sleep 2
            cleanup_temp_files
            ;;
        manual|never)
            # Don't cleanup
            ;;
    esac
}

convert_only() {
    local input_file="$1"
    local output_file="$2"
    
    # Validate input
    if [[ ! -f "$input_file" ]]; then
        echo "Error: Input file not found: $input_file" >&2
        return 1
    fi
    
    # Determine handler from input extension
    local ext handler
    ext="$(get_file_extension "$input_file")"
    handler="$(get_handler_for_format "$ext")"
    
    if [[ -z "$handler" ]]; then
        echo "Error: No handler for .$ext files" >&2
        return 1
    fi
    
    # Determine output format from output extension if different from config
    local out_ext
    out_ext="$(get_file_extension "$output_file")"
    if [[ "$out_ext" != "$OUTPUT_FORMAT" ]]; then
        OUTPUT_FORMAT="$out_ext"
        log_debug "Output format set to: $OUTPUT_FORMAT"
    fi
    
    ensure_temp_dir
    
    echo "Converting: $input_file → $output_file"
    
    if "$handler" "$input_file" "$output_file"; then
        show_notification "Conversion Complete" "Saved: $(basename "$output_file")"
        echo "Success: $output_file"
        cleanup_temp_files
        return 0
    else
        echo "Error: Conversion failed" >&2
        cleanup_temp_files
        return 1
    fi
}

# =============================================================================
# COMMAND LINE INTERFACE
# =============================================================================

print_usage() {
    cat <<EOF
DistinctionOS XWM Player v${VERSION}
Play Bethesda game audio formats (XWM, FUZ) in standard audio players

USAGE:
    $SCRIPT_NAME [OPTIONS] <file>           Play an audio file
    $SCRIPT_NAME --convert <in> <out>       Convert without playing
    $SCRIPT_NAME --cleanup                  Remove temporary files
    $SCRIPT_NAME --help                     Show this help message
    $SCRIPT_NAME --version                  Show version information

OPTIONS:
    --desktop           Mark as invoked by desktop file (suppresses notifications)
    --format <fmt>      Override output format (ogg, mp3, flac, wav)
    --player <app>      Override audio player
    --no-gui            Disable GUI error dialogues
    --debug             Enable debug logging to stderr

SUPPORTED FORMATS:
    .xwm    Microsoft xWMA (Skyrim, Fallout, etc.)
    .fuz    Bethesda voice files (contains xWMA + lip sync)

CONFIGURATION:
    System:  $SYSTEM_CONFIG
    Local:   $LOCAL_CONFIG  
    User:    $USER_CONFIG

EXAMPLES:
    $SCRIPT_NAME music.xwm
    $SCRIPT_NAME --convert voice.fuz voice.ogg
    $SCRIPT_NAME --format mp3 --player vlc music.xwm
EOF
}

print_version() {
    echo "DistinctionOS XWM Player v${VERSION}"
}

main() {
    local action="play"
    local input_file=""
    local output_file=""
    
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                print_usage
                exit 0
                ;;
            --version|-v)
                print_version
                exit 0
                ;;
            --desktop)
                INVOKED_BY_DESKTOP="true"
                shift
                ;;
            --convert|-c)
                action="convert"
                shift
                ;;
            --cleanup)
                action="cleanup"
                shift
                ;;
            --format|-f)
                OUTPUT_FORMAT="$2"
                shift 2
                ;;
            --player|-p)
                PLAYER_COMMAND="$2"
                shift 2
                ;;
            --no-gui)
                GUI_ERRORS="false"
                shift
                ;;
            --debug|-d)
                LOG_LEVEL="debug"
                shift
                ;;
            -*)
                echo "Unknown option: $1" >&2
                print_usage
                exit 1
                ;;
            *)
                if [[ -z "$input_file" ]]; then
                    input_file="$1"
                elif [[ -z "$output_file" ]]; then
                    output_file="$1"
                fi
                shift
                ;;
        esac
    done
    
    # Load configuration
    load_all_configs
    load_handlers
    
    # Execute action
    case "$action" in
        play)
            if [[ -z "$input_file" ]]; then
                echo "Error: No input file specified" >&2
                print_usage
                exit 1
            fi
            convert_and_play "$input_file"
            ;;
        convert)
            if [[ -z "$input_file" ]] || [[ -z "$output_file" ]]; then
                echo "Error: --convert requires input and output files" >&2
                print_usage
                exit 1
            fi
            convert_only "$input_file" "$output_file"
            ;;
        cleanup)
            cleanup_all_temp
            echo "Cleanup complete"
            ;;
    esac
}

# =============================================================================
# ENTRY POINT
# =============================================================================

# Set up signal handlers for graceful cleanup
trap 'cleanup_temp_files' EXIT INT TERM

main "$@"
